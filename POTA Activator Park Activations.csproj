<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>PotaActivatorParkActivations</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Jeremy S. Gaynor, K5JSG</Authors>
    <Company>K5JSG</Company>
    <Copyright>Copyright © 2026. Jeremy S. Gaynor, K5JSG. All Rights Reserved.</Copyright>
    <Description>This program is designed to get all parks in a state with their counties, and then compare it to a adif file.  It will mark any parks already worked automatically.  You can then export your finished report as either a .csv or .xlxm file.</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Version>1.14.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
    <!-- Window icons and the logo shown in the main window - see AppLogo.cs.
         Logo.png (the full-size source artwork) is kept in the project folder
         to regenerate these from, not shipped. -->
    <EmbeddedResource Include="logo.ico" LogicalName="AppLogo/logo.ico" />
    <EmbeddedResource Include="logo-256.png" LogicalName="AppLogo/logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools/ holds its own separate console-app projects (see the .slnx) -
         without this, this project's default recursive file glob would also
         try to compile their source files into itself. -->
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Leaflet, protomaps-leaflet and the offline map style, built into the
         exe and served by the map's local server (Form1.RunMapServer) so the
         map opens with no internet connection. Named by their path under
         MapAssets/ with forward slashes, e.g. "MapAssets/leaflet/leaflet.js". -->
    <EmbeddedResource Include="MapAssets\**\*" LogicalName="MapAssets/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="counties.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="HelpContent.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ParkElevations.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="cqZones.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ituZones.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>